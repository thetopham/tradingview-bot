PROJECTX_USERNAME=
PROJECTX_API_KEY=
PROJECTX_ACCOUNT_ID=
TV_PORT=5000
WEBHOOK_SECRET=
DASHBOARD_PASSWORD=

# Supabase + n8n
SUPABASE_URL=
SUPABASE_KEY=

TRADE_STATE_PATH=./trade_state.json

# Account mapping
ACCOUNT_ALPHA=
ACCOUNT_BETA=
ACCOUNT_GAMMA=
ACCOUNT_DELTA=
ACCOUNT_EPSILON=
ACCOUNT_PRACTICE=

#overide contract
OVERRIDE_CONTRACT_ID=

N8N_WEBHOOK_URL=


#per model overseers
N8N_AI_URL=
N8N_AI_URL_ALPHA=
N8N_AI_URL_BETA=
N8N_AI_URL_GAMMA=
N8N_AI_URL_DELTA=
N8N_AI_URL_EPSILON=
N8N_CHART_FETCH_URL=
N8N_5MCHART_FETCH_URL=
N8N_15MCHART_FETCH_URL=
N8N_30MCHART_FETCH_URL=
# Overseer test routes (account -> test slot)
# TEST1: beta
# TEST2: alpha
# TEST3: gamma
# TEST4: delta
# TEST5: epsilon
N8N_OVERSEER_URL_TEST1=
N8N_OVERSEER_URL_TEST2=
N8N_OVERSEER_URL_TEST3=
N8N_OVERSEER_URL_TEST4=
N8N_OVERSEER_URL_TEST5=

# Risk limits
MAX_DAILY_LOSS=-250.0
DAILY_PROFIT_TARGET=99999999
MAX_CONSECUTIVE_LOSSES=999999

# ------------------------------------------------------------------
# Regime filter 
# Blocks trades unless market is a low-volatility trend up/down.
#
# Defaults are tuned for "trend + calm" (reduces chop/range overtrading).
# ------------------------------------------------------------------
REGIME_FILTER_ENABLED=true
REGIME_FAIL_CLOSED=true

# Supabase tables (defaults match the repo + n8n datafeed tables)
REGIME_TABLE_5M=tv_datafeed_5m
REGIME_TABLE_HTF=tv_datafeed_30m
REGIME_TABLE_HTF_FALLBACK=tv_datafeed_15m

# Lookbacks
REGIME_LOOKBACK_BARS=140
REGIME_ER_LOOKBACK=12
REGIME_ATR_PCTL_LOOKBACK=50

# Thresholds
REGIME_ER_MIN=0.35
REGIME_ATR_PCTL_MAX=0.25
REGIME_EMA_SPREAD_ATR_MIN=0.30
REGIME_SLOPE_ATR_MIN=0.50
REGIME_REQUIRE_HTF_ALIGN=true

# Optional absolute ATR guards (MES points). Leave blank to disable.
# Example safe starting point for MES:
#   REGIME_ATR_MAX_POINTS=4.0
REGIME_ATR_MIN_POINTS=
REGIME_ATR_MAX_POINTS=
