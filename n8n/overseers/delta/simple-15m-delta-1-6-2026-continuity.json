        "jsCode": "const nowMs = Date.now();\nconst row = $input.first().json || null;\n\nconst parseTs = (t) => {\n  const ms = t ? Date.parse(t) : NaN;\n  return Number.isFinite(ms) ? ms : null;\n};\n\nconst exit_time = row?.exit_time ?? null;\nconst exitMs = parseTs(exit_time);\n\nconst minutes_since_last_close =\n  exitMs == null ? null : Math.round(((nowMs - exitMs) / 60000) * 10) / 10;\n\nconst pnlNum = row?.net_pnl == null ? null : Number(row.net_pnl);\n\nlet last_trade_outcome = null; // WIN | LOSS | BE | null\nif (pnlNum != null && Number.isFinite(pnlNum)) {\n  last_trade_outcome = pnlNum > 0 ? \"WIN\" : (pnlNum < 0 ? \"LOSS\" : \"BE\");\n}\n\nreturn [{\n  json: {\n    minutes_since_last_close,\n    last_trade_outcome,\n    last_trade_pnl: pnlNum,\n    last_trade_signal: row?.signal ?? null,\n    last_trade_size: row?.size ?? null,\n    last_trade_ai_decision_id: row?.ai_decision_id ?? null,\n  }\n}];\n"
