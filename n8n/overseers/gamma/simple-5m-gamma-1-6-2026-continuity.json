    {
      "parameters": {
        "jsCode": "// Expect the most recent CLOSED 5m bar (align to 5-minute boundary)\nconst now = new Date();\nconst ms = now.getTime();\nconst fiveMin = 5 * 60 * 1000;\n\n// use the previous completed bar close time\nconst expected = new Date(Math.floor(ms / fiveMin) * fiveMin);\n\nreturn [{ json: { expected_ts: expected.toISOString() } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -304,
        352
      ],
      "id": "32867f54-154a-4886-9bdc-40c53925f4ff",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "// 5m derived snapshot (n8n Code node)\n// Expects input shaped like: { data: [ ...rows... ] } where rows are from tv_datafeed (limit=5)\n\nconst rows = ($input.first().json.data || []).filter(Boolean);\nif (!rows.length) return [{ json: { error: \"No tv_datafeed rows\" } }];\n\n// Supabase returns ts DESC (newest first). Normalize to ASC for slope/momentum.\nrows.sort((a, b) => Date.parse(a.ts) - Date.parse(b.ts));\n\nconst N = rows.length;\nconst first = rows[0];\nconst last = rows[N - 1];\nconst prev = rows[Math.max(N - 2, 0)];\n\nconst num = (x) => (x === null || x === undefined ? null : Number(x));\nconst r = (x) =>\n  (x === null || x === undefined || Number.isNaN(Number(x)))\n    ? null\n    : Math.round(Number(x) * 100) / 100;\n\n// Latest bar core values\nconst c = num(last.c);\nconst vwap = num(last.vwap);\nconst ema9 = num(last.ema9);\nconst ema21 = num(last.ema21);\nconst atr = num(last.atr);\n\nconst macd_last = num(last.macd_hist);\nconst macd_prev = num(prev.macd_hist);\nconst macd_first = num(first.macd_hist);\n\n// Deltas vs value / structure\nconst c_minus_vwap_pts = (c != null && vwap != null) ? (c - vwap) : null;\nconst c_minus_ema21_pts = (c != null && ema21 != null) ? (c - ema21) : null;\n\n// Slopes over N bars (oldest -> newest)\nconst first_c = num(first.c);\nconst last_c = num(last.c);\nconst first_ema9 = num(first.ema9);\nconst last_ema9 = num(last.ema9);\nconst first_ema21 = num(first.ema21);\nconst last_ema21 = num(last.ema21);\n\nconst c_slope_n = (last_c != null && first_c != null) ? (last_c - first_c) : null;\nconst ema9_slope_n = (last_ema9 != null && first_ema9 != null) ? (last_ema9 - first_ema9) : null;\nconst ema21_slope_n = (last_ema21 != null && first_ema21 != null) ? (last_ema21 - first_ema21) : null;\n\n// MACD deltas\nconst macd_delta_1 = (macd_last != null && macd_prev != null) ? (macd_last - macd_prev) : null;\nconst macd_delta_n = (macd_last != null && macd_first != null) ? (macd_last - macd_first) : null;\n\n// Rounded deltas for stable boolean logic\nconst macd_delta_1_r = r(macd_delta_1);\nconst macd_delta_n_r = r(macd_delta_n);\n\n// Flags\nconst macd_falling = (macd_delta_1_r != null) ? (macd_delta_1_r < 0) : null;\nconst macd_below_zero = (macd_last != null) ? (macd_last < 0) : null;\nconst ema_bearish = (ema9 != null && ema21 != null) ? (ema9 < ema21) : null;\n\n// Simple trend strength score (-3..+3)\nconst trend_score = Number(\n  (ema9 != null && ema21 != null ? Math.sign(ema9 - ema21) : 0) +\n  (ema9_slope_n != null ? Math.sign(ema9_slope_n) : 0) +\n  (macd_delta_n_r != null ? Math.sign(macd_delta_n_r) : 0)\n);\n\n// Direction-aware “momentum improved” booleans\nconst momentum_improved_long =\n  (macd_delta_1_r != null && macd_delta_1_r > 0) &&\n  (trend_score >= 2) &&\n  (ema_bearish === false);\n\nconst momentum_improved_short =\n  (macd_delta_1_r != null && macd_delta_1_r < 0) &&\n  (trend_score <= -2) &&\n  (ema_bearish === true);\n\n// Optional extra context (cheap + useful)\nconst ema_spread = (ema9 != null && ema21 != null) ? (ema9 - ema21) : null;\n\n// Brackets (points + $) — TP $60, SL $30, sized by contract count\nconst POINT_VALUE_USD = 5;\nconst brackets = {\n  1: { sl_pts: 12, tp_pts: 6 },\n  2: { sl_pts: 6, tp_pts: 3 },\n  3: { sl_pts: 4, tp_pts: 2 },\n};\n\nfor (const k of Object.keys(brackets)) {\n  const size = Number(k);\n  brackets[size].sl_usd = brackets[size].sl_pts * POINT_VALUE_USD * size;\n  brackets[size].tp_usd = brackets[size].tp_pts * POINT_VALUE_USD * size;\n}\n\n// ATR multiples\nconst atr_ok = (atr != null && atr > 0);\nconst tp_to_atr_size1 = atr_ok ? (brackets[1].tp_pts / atr) : null;\nconst sl_to_atr_size1 = atr_ok ? (brackets[1].sl_pts / atr) : null;\nconst tp_to_atr_size2 = atr_ok ? (brackets[2].tp_pts / atr) : null;\nconst sl_to_atr_size2 = atr_ok ? (brackets[2].sl_pts / atr) : null;\nconst tp_to_atr_size3 = atr_ok ? (brackets[3].tp_pts / atr) : null;\nconst sl_to_atr_size3 = atr_ok ? (brackets[3].sl_pts / atr) : null;\n\n// 5-bar series (transparent context; oldest->newest)\nconst series_n = rows.map(x => ({\n  ts: x.ts ?? null,\n  o: num(x.o),\n  h: num(x.h),\n  l: num(x.l),\n  c: num(x.c),\n  v: num(x.v),\n  ema9: num(x.ema9),\n  ema21: num(x.ema21),\n  vwap: num(x.vwap),\n  atr: num(x.atr),\n  macd_hist: num(x.macd_hist),\n}));\n\nreturn [{\n  json: {\n    // latest bar fields\n    ts: last.ts,\n    c,\n    ema9,\n    ema21,\n    vwap,\n    atr,\n    macd_hist: macd_last,\n\n    // continuity helpers\n    momentum_improved_long,\n    momentum_improved_short,\n\n    // short history\n    series_n,\n    series_len: N,\n\n    // slopes / deltas / flags\n    c_slope_n: r(c_slope_n),\n    ema9_slope_n: r(ema9_slope_n),\n    ema21_slope_n: r(ema21_slope_n),\n\n    macd_delta_1: macd_delta_1_r,\n    macd_delta_n: macd_delta_n_r,\n    macd_falling,\n    macd_below_zero,\n\n    ema_bearish,\n    trend_score,\n    ema_spread: r(ema_spread),\n\n    c_minus_vwap_pts: r(c_minus_vwap_pts),\n    c_minus_ema21_pts: r(c_minus_ema21_pts),\n\n    // ATR multiples\n    tp_to_atr_size1: r(tp_to_atr_size1),\n    sl_to_atr_size1: r(sl_to_atr_size1),\n    tp_to_atr_size2: r(tp_to_atr_size2),\n    sl_to_atr_size2: r(sl_to_atr_size2),\n    tp_to_atr_size3: r(tp_to_atr_size3),\n    sl_to_atr_size3: r(sl_to_atr_size3),\n\n    // bracket metadata\n    point_value_usd: POINT_VALUE_USD,\n    brackets,\n  }\n}];\n"
      },
