        "jsCode": "const row = $input.first().json;\n\nconst c = Number(row.c);\nconst vwap = Number(row.vwap);\nconst ema21 = Number(row.ema21);\nconst atr = Number(row.atr);\n\nconst c_minus_vwap_pts = c - vwap;\nconst c_minus_ema21_pts = c - ema21;\n\n// === Topstep bracket distances (POINTS) by size ===\n// Your mapping:\n// 1 contract = SL/TP 6/6\n// 2 contracts = 3/3\n// 3 contracts = 2/2\nconst POINT_VALUE_USD = 5; // MES = $5 per point per contract\n\nconst brackets = {\n  1: { sl_pts: 6, tp_pts: 6 },\n  2: { sl_pts: 3, tp_pts: 3 },\n  3: { sl_pts: 2, tp_pts: 2 },\n};\n\n// add USD equivalents (risk stays ~$30, TP ~$30) for clarity\nfor (const k of Object.keys(brackets)) {\n  const size = Number(k);\n  brackets[size].sl_usd = brackets[size].sl_pts * POINT_VALUE_USD * size;\n  brackets[size].tp_usd = brackets[size].tp_pts * POINT_VALUE_USD * size;\n}\n\n// ATR multiples (keep your existing fields, but also make them explicit in the table)\nconst tp_to_atr_size1 = atr ? brackets[1].tp_pts / atr : null;\nconst sl_to_atr_size1 = atr ? brackets[1].sl_pts / atr : null;\nconst tp_to_atr_size2 = atr ? brackets[2].tp_pts / atr : null;\nconst sl_to_atr_size2 = atr ? brackets[2].sl_pts / atr : null;\nconst tp_to_atr_size3 = atr ? brackets[3].tp_pts / atr : null;\nconst sl_to_atr_size3 = atr ? brackets[3].sl_pts / atr : null;\n\n// Round helper (2 decimals)\nconst r = (x) => (x == null ? null : Math.round(x * 100) / 100);\n\n// Human-readable line so the model can’t “ignore” the JSON\nconst bracket_summary =\n  `SIZE->BRACKET: ` +\n  `1=SL ${brackets[1].sl_pts}pt($${brackets[1].sl_usd}) TP ${brackets[1].tp_pts}pt($${brackets[1].tp_usd}); ` +\n  `2=SL ${brackets[2].sl_pts}pt($${brackets[2].sl_usd}) TP ${brackets[2].tp_pts}pt($${brackets[2].tp_usd}); ` +\n  `3=SL ${brackets[3].sl_pts}pt($${brackets[3].sl_usd}) TP ${brackets[3].tp_pts}pt($${brackets[3].tp_usd}).`;\n\nreturn [{\n  json: {\n    ...row,\n\n    // deltas\n    c_minus_vwap_pts: r(c_minus_vwap_pts),\n    c_minus_ema21_pts: r(c_minus_ema21_pts),\n\n    // original ATR multiple fields (kept)\n    tp_to_atr_size1: r(tp_to_atr_size1),\n    sl_to_atr_size1: r(sl_to_atr_size1),\n    tp_to_atr_size2: r(tp_to_atr_size2),\n    sl_to_atr_size2: r(sl_to_atr_size2),\n    tp_to_atr_size3: r(tp_to_atr_size3),\n    sl_to_atr_size3: r(sl_to_atr_size3),\n\n    // NEW: explicit bracket points + dollars + point value\n    point_value_usd: POINT_VALUE_USD,\n    brackets, // {1:{sl_pts,tp_pts,sl_usd,tp_usd}, ...}\n    bracket_summary,\n  }\n}];\n"
      },
