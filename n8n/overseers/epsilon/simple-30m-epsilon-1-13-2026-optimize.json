      "parameters": {
        "jsCode": "let raw = $input.first().json.text;\n\n// Normalize to string\nraw = String(raw ?? \"\").trim();\n\n// Strip code fences if present\nraw = raw\n  .replace(/^```json\\s*/i, \"\")\n  .replace(/^```\\s*/i, \"\")\n  .replace(/```$/i, \"\")\n  .trim();\n\n// Try parse directly; if it fails, extract first {...} JSON block\nlet obj;\ntry {\n  obj = JSON.parse(raw);\n} catch (e) {\n  const start = raw.indexOf(\"{\");\n  const end = raw.lastIndexOf(\"}\");\n  if (start >= 0 && end > start) {\n    obj = JSON.parse(raw.slice(start, end + 1));\n  } else {\n    throw e;\n  }\n}\n\n// Hardening: make reason single-line\nif (typeof obj.reason === \"string\") {\n  obj.reason = obj.reason.replace(/\\r?\\n|\\r/g, \" \").replace(/\\s+/g, \" \").trim();\n}\n\n// Optional: enforce size as integer\nif (obj.size !== undefined) {\n  obj.size = Number.parseInt(obj.size, 10);\n}\n\n// Return as a proper n8n item\nreturn [{ json: obj }];\n"
      },
